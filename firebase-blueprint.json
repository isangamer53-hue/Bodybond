{
  "entities": {
    "CustomerOrder": {
      "title": "CustomerOrder",
      "description": "Represents a customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 200 },
        "customerPhone": { "type": "string", "maxLength": 50 },
        "customerEmail": { "type": "string", "maxLength": 200 },
        "address": { "type": "string", "maxLength": 1000 },
        "city": { "type": "string", "maxLength": 100 },
        "zone": { "type": "string", "maxLength": 50 },
        "subtotalBDT": { "type": "number" },
        "deliveryFeeBDT": { "type": "number" },
        "discountBDT": { "type": "number" },
        "totalBDT": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "estimatedDeliveryDate": { "type": "string", "maxLength": 100 },
        "courierName": { "type": "string", "maxLength": 100 },
        "courierTrackingCode": { "type": "string", "maxLength": 100 },
        "adminNotes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "customerName", "customerPhone", "address", "city", "zone", "totalBDT", "status", "createdAt"]
    },
    "CouponCode": {
      "title": "CouponCode",
      "description": "Store discount coupon code",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 50 },
        "isActive": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 500 },
        "usageCount": { "type": "number" }
      },
      "required": ["id", "code", "isActive"]
    },
    "AnnouncementConfig": {
      "title": "AnnouncementConfig",
      "description": "Global store announcement and countdown timer settings",
      "type": "object",
      "properties": {
        "topBarText": { "type": "string", "maxLength": 500 },
        "showTopBar": { "type": "boolean" },
        "highlightBadgeText": { "type": "string", "maxLength": 100 },
        "freeShippingThresholdBDT": { "type": "number" },
        "insideDhakaFeeBDT": { "type": "number" },
        "outsideDhakaFeeBDT": { "type": "number" },
        "whatsappNumber": { "type": "string", "maxLength": 50 },
        "emergencySupportPhone": { "type": "string", "maxLength": 50 },
        "showOfferCountdown": { "type": "boolean" },
        "offerCountdownHours": { "type": "number" },
        "offerCountdownMinutes": { "type": "number" },
        "offerCountdownSeconds": { "type": "number" },
        "offerCountdownLabel": { "type": "string", "maxLength": 100 }
      },
      "required": ["topBarText", "showTopBar"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "CustomerOrder",
      "description": "All submitted customer orders"
    },
    "/coupons/{couponId}": {
      "schema": "CouponCode",
      "description": "Discount codes"
    },
    "/settings/{settingId}": {
      "schema": "AnnouncementConfig",
      "description": "Global store configuration and offer countdown timer"
    }
  }
}
